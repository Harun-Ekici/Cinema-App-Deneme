---
import Layout from '../../layouts/Layout.astro';
import EtkinlikDetay from '../../components/EtkinlikDetay.svelte';

export function getStaticPaths() {
  return [1, 2, 3, 4, 5, 6].map((id) => ({ params: { id: String(id) } }));
}

const { id } = Astro.params;
---

<Layout title="Film Detayı — CineQ">
  <EtkinlikDetay client:load filmId={id} />
</Layout>
