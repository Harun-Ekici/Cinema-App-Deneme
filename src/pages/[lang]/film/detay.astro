---
import Layout from '../../../layouts/Layout.astro';
import EtkinlikDetay from '../../../components/EtkinlikDetay.svelte';
import type { UygulamaDili } from '$lib/i18n/liste-durumlari';

type OnekliDil = Exclude<UygulamaDili, 'tr'>;

export function getStaticPaths() {
  const diller: OnekliDil[] = ['en', 'ar', 'fa'];
  return diller.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
  lang: OnekliDil;
}

const { lang } = Astro.props;
---

<Layout title="Film Detayı — CineQ">
  <EtkinlikDetay client:load lang={lang} />
</Layout>
