---
import Layout from '../../../layouts/Layout.astro';
import EtkinlikDetay from '../../../components/EtkinlikDetay.svelte';
import type { UygulamaDili } from '$lib/i18n/liste-durumlari';

type OnekliDil = Exclude<UygulamaDili, 'tr'>;

export function getStaticPaths() {
  const diller: OnekliDil[] = ['en', 'ar', 'fa'];
  return diller.flatMap((lang) =>
    [1, 2, 3, 4, 5, 6].map((id) => ({
      params: { lang, id: String(id) },
      props: { lang },
    })),
  );
}

interface Props {
  lang: OnekliDil;
}

const { id } = Astro.params;
const { lang } = Astro.props;
---

<Layout title="Film Detayı — CineQ">
  <EtkinlikDetay client:load filmId={id} lang={lang} />
</Layout>
