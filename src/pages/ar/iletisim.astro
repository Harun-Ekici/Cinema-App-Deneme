---
import Layout from '../../layouts/Layout.astro';
import DilSecici from '../../components/DilSecici.astro';
import IletisimFormu from '../../components/IletisimFormu.svelte';
---

<Layout title="اتصل بنا — CineQ">
  <div class="sayfa-kapsayici">
    <div class="kart" style="padding: 24px;">
      <DilSecici sayfa="iletisim" />
      <h1 class="baslik">اتصل بنا</h1>
      <p class="aciklama">املأ النموذج لإرسال آرائك واقتراحاتك أو طلبات الدعم.</p>
      <hr class="ayrac" />
      <IletisimFormu client:load dil="ar" />
    </div>
  </div>
</Layout>

<style>
  .sayfa-kapsayici {
    padding: 16px;
    max-width: 600px;
    margin: 0 auto;
  }
  .baslik {
    margin: 0 0 8px 0;
    color: var(--yazi);
    font-size: 22px;
  }
  .aciklama {
    color: var(--yazi-soluk);
    margin: 0 0 16px 0;
    font-size: 14px;
  }
  .ayrac {
    border: none;
    border-top: 1px solid var(--kenar);
    margin-bottom: 20px;
  }
</style>
