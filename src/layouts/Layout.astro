---
import { ClientRouter } from 'astro:transitions';
import AppHeader from '../components/AppHeader.svelte';
import AppNav from '../components/AppNav.svelte';
import '../styles/app.css';

interface Props {
  title?: string;
}

const { title = "CineQ" } = Astro.props;
const currentPath = Astro.url.pathname;

// Dil rotası: /en, /ar, /fa altındaki sayfalar kendi dilinde ve yönünde açılır
const dilBolumu = Astro.url.pathname.split('/')[1];
const dil = ['en', 'ar', 'fa'].includes(dilBolumu) ? dilBolumu : 'tr';
const yon = dil === 'ar' || dil === 'fa' ? 'rtl' : 'ltr';
---

<!doctype html>
<html lang={dil} dir={yon}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/cineq-logo.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <script is:inline>
      (function() {
        const kayitli = localStorage.getItem("cineq_tema") || localStorage.getItem("tema") || "sistem";
        let aktif = kayitli;
        if (kayitli === "sistem") {
          aktif = window.matchMedia("(prefers-color-scheme: dark)").matches ? "sinema" : "aydinlik";
        } else if (kayitli === "gece") {
          aktif = "sinema";
        } else if (kayitli === "gunduz") {
          aktif = "aydinlik";
        }
        document.documentElement.dataset.tema = aktif;
        document.documentElement.dataset.theme = aktif;
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <AppHeader client:load />
    <main>
      <slot />
    </main>
    <AppNav client:load currentPath={currentPath} />
  </body>
</html>

<style>
  main {
    padding-bottom: calc(80px + env(safe-area-inset-bottom));
    min-height: calc(100vh - 58px);
    background: var(--zemin);
    transition: margin-inline-start 0.2s ease;
  }

  @media (min-width: 1024px) {
    main {
      margin-inline-start: 240px;
      padding-bottom: 40px;
    }
  }
</style>
