---
import Layout from '../../layouts/Layout.astro';
import EtkinlikDetay from '../../components/EtkinlikDetay.svelte';
import { filmler, type Film } from '$lib/data';

export function getStaticPaths() {
  return filmler.map((film) => ({
    params: { id: String(film.id) },
    props: { film },
  }));
}

interface Props {
  film: Film;
}

const { film } = Astro.props;
---

<Layout title={`${film.baslik} — CineQ`}>
  <EtkinlikDetay client:load etkinlik={film} lang="tr" />
</Layout>
