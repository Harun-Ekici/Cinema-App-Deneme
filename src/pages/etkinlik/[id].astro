---
import Layout from '../../layouts/Layout.astro';
import EtkinlikDetay from '../../components/EtkinlikDetay.svelte';
import { filmler, type Film } from '$lib/data';

export function getStaticPaths() {
  return filmler.map((f) => ({
    params: { id: String(f.id) },
    props: { etkinlik: f },
  }));
}

interface Props {
  etkinlik: Film;
}

const { etkinlik } = Astro.props;
---

<Layout title={`${etkinlik.baslik} — CineQ`}>
  <EtkinlikDetay client:load etkinlik={etkinlik} />
</Layout>
